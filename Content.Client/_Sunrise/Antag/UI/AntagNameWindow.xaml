<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'antag-name-eui-window-title'}"
               SetSize="420 170"
               Resizable="False">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <Label Name="RoleTitle" StyleClasses="LabelKeyText" HorizontalAlignment="Center" />
        <Label Text="{Loc 'antag-name-eui-prompt'}" />
        <Label Name="CurrentName" StyleClasses="LabelSubText" />
        <LineEdit Name="NameInput" HorizontalExpand="True" PlaceHolder="{Loc 'antag-name-eui-placeholder'}" />
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right" SeparationOverride="6" Margin="0 4 0 0">
            <Button Name="RandomButton" Text="{Loc 'antag-name-eui-random'}" />
            <Button Name="ConfirmButton" Text="{Loc 'antag-name-eui-confirm'}" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
